# Webhook サーバー (npm run webhook-server) 用。.env.example をコピーして .env.local を作成し、値を設定する。
# client/.env.local の Supabase の値と同じでよい。

# Supabase (https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# または client と同じ名前の変数でも読み込まれる
# NEXT_PUBLIC_SUPABASE_URL=

# Strava トークン暗号化・復号用（client の STRAVA_TOKEN_ENCRYPTION_KEY と同一の値。必須）。
# 平文トークンの保存・使用経路は存在しない。未設定の場合は暗号化に失敗し、/users/sync が保存を拒否する（500）。
# 復号に失敗した場合も Webhook 処理は停止する。
STRAVA_TOKEN_ENCRYPTION_KEY=

# 内部 API 認証用共有キー（client の INTERNAL_API_KEY と同一の値を設定すること）。
# 全 POST エンドポイントで x-internal-api-key ヘッダと照合する。未設定の場合は全リクエストを拒否する（fail closed）。
INTERNAL_API_KEY=
# 初期バックフィル用の従来キー（後方互換。/users/initial-backfill は x-internal-backfill-key でも通る）
INTERNAL_BACKFILL_API_KEY=
