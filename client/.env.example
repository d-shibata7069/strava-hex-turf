# Strava OAuth (https://developers.strava.com/docs/authentication/)
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# アプリのベースURL（末尾スラッシュなし推奨）。ローカル: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
# プロジェクト選択 → Settings → API で Project URL / anon key / service_role key を確認
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: 上記 API 画面の "Project API keys" の service_role（secret）。RLS をバイパスするためサーバー専用・漏洩禁止
SUPABASE_SERVICE_ROLE_KEY=
